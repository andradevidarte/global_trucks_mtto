/* ============================================
   GALERÍA DE IMÁGENES - DIAGNÓSTICOS
   ============================================ */

/* Contenedor principal */
.o_diagnosis_image_gallery_container {
    margin-top: 20px;
}

.o_diagnosis_image_gallery_grid {
    width: 100%;
}

.o_diagnosis_image_gallery_grid .o_kanban_view {
    display: grid !important;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)) !important;
    gap: 20px !important;
    padding: 15px 0 !important;
}

/* Caja de cada imagen */
.o_attachment_kanban_box {
    background: white;
    border: 2px solid #D4AF37;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
}

.o_attachment_kanban_box:hover {
    transform: translateY(-5px);
    box-shadow: 0 6px 16px rgba(212, 175, 55, 0.3);
    border-color: #B8941F;
}

/* Contenedor de imagen */
.o_attachment_image_container {
    position: relative;
    width: 100%;
    height: 180px;
    background: #f5f5f5;
    overflow: hidden;
}

.o_attachment_image_frame {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.o_image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.o_attachment_thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
}

.o_attachment_kanban_box:hover .o_attachment_thumbnail {
    transform: scale(1.1);
}

/* Overlay con lupa */
.o_attachment_overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
}

.o_attachment_overlay i {
    color: white;
    font-size: 36px;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
}

.o_attachment_kanban_box:hover .o_attachment_overlay {
    opacity: 1;
}

/* OCULTAR detalles de la imagen (nombre y fecha) */
.o_attachment_details {
    display: none !important;
}

/* Botón de eliminar compacto */
.o_attachment_actions {
    padding: 10px;
    background: #f9f9f9;
    border-top: 1px solid #e0e0e0;
}

.o_attachment_actions a {
    font-size: 13px;
}

/* ============================================
   BOTÓN DE SUBIR IMÁGENES (MEJORADO)
   ============================================ */

/* Contenedor del botón de subir */
.o_diagnosis_section_header .o_field_many2manybinary {
    display: block !important;
    text-align: center !important;
    padding: 15px 0 20px 0 !important;
    margin-bottom: 10px !important;
}

/* Estilo del botón de subir */
.o_diagnosis_section_header .o_field_many2manybinary .o_attach,
.o_diagnosis_section_header .o_field_many2manybinary .o_input_file {
    background: linear-gradient(135deg, #D4AF37 0%, #B8941F 100%) !important;
    color: white !important;
    border: none !important;
    padding: 14px 28px !important;
    border-radius: 8px !important;
    font-size: 16px !important;
    font-weight: 600 !important;
    cursor: pointer !important;
    transition: all 0.3s ease !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;
    box-shadow: 0 4px 12px rgba(212, 175, 55, 0.4) !important;
    text-transform: uppercase !important;
    letter-spacing: 0.5px !important;
}

.o_diagnosis_section_header .o_field_many2manybinary .o_attach:hover,
.o_diagnosis_section_header .o_field_many2manybinary .o_input_file:hover {
    background: linear-gradient(135deg, #B8941F 0%, #D4AF37 100%) !important;
    transform: scale(1.05) !important;
    box-shadow: 0 6px 16px rgba(212, 175, 55, 0.6) !important;
}

/* Ícono de cámara antes del texto */
.o_diagnosis_section_header .o_field_many2manybinary .o_attach::before {
    content: '📷' !important;
    font-size: 20px !important;
    margin-right: 5px !important;
}

/* Hacer que el input file acepte capturas de cámara */
.o_diagnosis_section_header .o_field_many2manybinary input[type="file"] {
    background: linear-gradient(135deg, #D4AF37 0%, #B8941F 100%) !important;
    color: white !important;
    padding: 14px 28px !important;
    border-radius: 8px !important;
    font-size: 16px !important;
    font-weight: 600 !important;
    cursor: pointer !important;
}

/* ============================================
   TÍTULOS DE SECCIONES CON ESTILO DORADO
   ============================================ */

.o_diagnosis_section_header > .o_horizontal_separator {

}

/* Campo de descripción más grande */
.o_diagnosis_section_header .o_field_text {
    min-height: 120px !important;
    font-size: 14px !important;
    line-height: 1.6 !important;
    padding: 12px !important;
    border: 1px solid #D4AF37 !important;
    border-radius: 6px !important;
    background: #fafafa !important;
}

.o_diagnosis_section_header .o_field_text:focus {
    background: white !important;
    border-color: #B8941F !important;
    box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1) !important;
}

/* Espaciado entre secciones */
.mt32 {
    margin-top: 32px !important;
}

/* Tabla de actividades dentro de la sección */
.o_diagnosis_section_header .o_field_one2many table {
    border: 1px solid #D4AF37 !important;
    border-radius: 6px !important;
    overflow: hidden !important;
}

.o_diagnosis_section_header .o_field_one2many table thead {
    background: linear-gradient(135deg, #D4AF37 0%, #F4E4A6 100%) !important;
}

.o_diagnosis_section_header .o_field_one2many table thead th {
    color: #333 !important;
    font-weight: 600 !important;
    padding: 12px !important;
}

.o_diagnosis_section_header .o_field_one2many table tbody tr:hover {
    background: #fffef5 !important;
}


.o_diagnosis_section_header .o_field_x2many_list_row_add a:hover {
    color: #B8941F !important;
}

/* Badge de contador */
.badge-info {
    background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
    color: white;
    padding: 6px 12px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 500;
}

/* ============================================
   RESPONSIVE - TABLETS
   ============================================ */

@media (max-width: 992px) {
    .o_diagnosis_image_gallery_grid .o_kanban_view {
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)) !important;
        gap: 15px !important;
    }
    
    .o_attachment_image_container {
        height: 160px;
    }
}

/* ============================================
   RESPONSIVE - MÓVILES
   ============================================ */

@media (max-width: 768px) {
    .o_diagnosis_image_gallery_grid .o_kanban_view {
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)) !important;
        gap: 12px !important;
    }
    
    .o_attachment_image_container {
        height: 140px;
    }
    
    /* Botón más grande en móviles */
    .o_diagnosis_section_header .o_field_many2manybinary .o_attach {
        padding: 16px 32px !important;
        font-size: 18px !important;
        width: 100% !important;
        max-width: 320px !important;
    }
}

@media (max-width: 480px) {
    .o_diagnosis_image_gallery_grid .o_kanban_view {
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 10px !important;
    }
    
    .o_attachment_image_container {
        height: 120px;
    }
}

/* ============================================
   ANIMACIÓN
   ============================================ */

@keyframes fadeInBox {
    from {
        opacity: 0;
        transform: scale(0.95);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

.o_attachment_kanban_box {
    animation: fadeInBox 0.3s ease;
}
