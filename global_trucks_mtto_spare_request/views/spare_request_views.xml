<odoo>
    <record id="view_maintenance_spare_request_list" model="ir.ui.view">
        <field name="name">maintenance.spare.request.list</field>
        <field name="model">maintenance.spare.request</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de Repuestos">
                <field name="name"/>
                <field name="order_id"/>
                <field name="requester_id"/>
                <field name="warehouse_id"/>
                <field name="request_date"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-info="state == 'requested'"
                       decoration-success="state == 'delivered'"
                       decoration-warning="state in ('approved','partially_delivered')"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_maintenance_spare_request_search" model="ir.ui.view">
        <field name="name">maintenance.spare.request.search</field>
        <field name="model">maintenance.spare.request</field>
        <field name="arch" type="xml">
            <search string="Buscar solicitudes">
                <field name="name"/>
                <field name="order_id"/>
                <field name="requester_id"/>
                <field name="warehouse_id"/>
                <filter name="pending_approval" string="Pendientes de aprobar" domain="[('state', '=', 'requested')]"/>
                <filter name="pending_delivery" string="Pendientes de entregar" domain="[('state', 'in', ('approved', 'partially_delivered'))]"/>
                <filter name="delivered" string="Entregadas" domain="[('state', '=', 'delivered')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_warehouse" string="Almacén" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_requester" string="Solicitante" context="{'group_by': 'requester_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_maintenance_spare_request_form" model="ir.ui.view">
        <field name="name">maintenance.spare.request.form</field>
        <field name="model">maintenance.spare.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de Repuestos">
                <header>
                    <button name="action_set_draft" type="object" string="Volver a borrador"
                            class="btn-secondary"
                            attrs="{'invisible': [('state', 'not in', ('requested', 'rejected', 'cancelled'))]}"/>
                    <button name="action_submit" type="object" string="Solicitar a almacén"
                            class="btn-primary"
                            groups="global_trucks_mtto_spare_request.group_spare_technician,global_trucks_mtto.group_mtto_admin,global_trucks_mtto.group_mtto_supervisor"
                            attrs="{'invisible': [('state', 'not in', ('draft', 'rejected'))]}"/>
                    <button name="action_approve" type="object" string="Aprobar"
                            class="btn-success"
                            groups="global_trucks_mtto_spare_request.group_spare_storekeeper,global_trucks_mtto.group_mtto_admin,global_trucks_mtto.group_mtto_supervisor"
                            attrs="{'invisible': [('state', 'not in', ('requested', 'approved', 'partially_delivered'))]}"/>
                    <button name="action_deliver" type="object" string="Registrar entrega"
                            class="btn-primary"
                            groups="global_trucks_mtto_spare_request.group_spare_storekeeper,global_trucks_mtto.group_mtto_admin,global_trucks_mtto.group_mtto_supervisor"
                            attrs="{'invisible': [('state', 'not in', ('approved', 'partially_delivered'))]}"/>
                    <button name="action_reject" type="object" string="Rechazar"
                            class="btn-danger"
                            groups="global_trucks_mtto_spare_request.group_spare_storekeeper,global_trucks_mtto.group_mtto_admin,global_trucks_mtto.group_mtto_supervisor"
                            attrs="{'invisible': [('state', 'not in', ('requested', 'approved', 'partially_delivered'))]}"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            class="btn-secondary"
                            attrs="{'invisible': [('state', 'in', ('cancelled', 'delivered'))]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,requested,approved,partially_delivered,delivered,rejected,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_id" options="{'no_create_edit': True}"/>
                            <field name="requester_id" readonly="1"/>
                            <field name="storekeeper_id" readonly="1"/>
                            <field name="line_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="warehouse_id"/>
                            <field name="source_location_id"/>
                            <field name="destination_location_id"/>
                            <field name="request_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="approved_by_id" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                            <field name="delivered_by_id" readonly="1"/>
                            <field name="delivered_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="rejected_by_id" readonly="1"/>
                            <field name="rejected_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="state" widget="badge"
                                       decoration-muted="state == 'draft'"
                                       decoration-info="state == 'requested'"
                                       decoration-warning="state in ('approved', 'partially_delivered')"
                                       decoration-success="state == 'delivered'"
                                       decoration-danger="state == 'rejected'"/>
                                <field name="product_id"/>
                                <field name="uom_id" readonly="1"/>
                                <field name="qty_requested"/>
                                <field name="qty_approved"/>
                                <field name="qty_delivered" readonly="1"/>
                                <field name="qty_available" readonly="1"/>
                                <field name="notes"/>
                            </list>
                        </field>
                    </group>
                    <group>
                        <field name="notes" placeholder="Notas internas de la solicitud..."/>
                        <field name="rejection_reason" placeholder="Motivo de rechazo (obligatorio para rechazar)."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_maintenance_spare_request" model="ir.actions.act_window">
        <field name="name">Solicitudes de Repuestos</field>
        <field name="res_model">maintenance.spare.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_maintenance_spare_request_search"/>
        <field name="context">{}</field>
    </record>
</odoo>
