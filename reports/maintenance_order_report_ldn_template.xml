<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template del Reporte LDN con Encabezado Personalizado -->
    <template id="report_maintenance_order_ldn_document">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <div class="page">
                    <!-- Encabezado Personalizado con Logo y Datos de Empresa (SIN estado) -->
                    <div class="row mb-4" style="border-bottom: 3px solid #875a7b; padding-bottom: 15px;">
                        <div class="col-3 text-center" style="display: flex; align-items: center; justify-content: center;">
                            <img src="/global_trucks_mtto/static/src/img/logo_ldn.png"
                                 style="max-width: 120px; max-height: 120px;"
                                 alt="Los Dobletroques Neva S.A.S"/>
                        </div>
                        <div class="col-9 text-center" style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
                            <h3 style="margin: 0; font-weight: bold; color: #875a7b;">Los Dobletroques Neiva S.A.S.</h3>
                            <p style="margin: 5px 0; font-size: 14px; color: #666;">Calle 13 sur #6A-24</p>
                            <h4 style="margin: 15px 0 5px 0; font-weight: bold;">Orden de Mantenimiento</h4>
                            <h5 style="margin: 0;">
                                <span t-field="o.name"/>
                            </h5>
                        </div>
                    </div>

                    <style>
                    .ldn-section-title{
                        border-bottom: 2px solid #875a7b;
                        padding-bottom: 6px;
                        margin: 0 0 10px 0;
                        font-weight: 600;
                        color: #2f2f2f;
                        font-size: 13px; /* ↓ más pequeño para verse elegante */
                    }

                    .ldn-card{
                        border: 1px solid #e5e5e5;
                        border-radius: 6px;
                        padding: 10px 12px;
                        background: #fff;
                    }

                    /* TABLAS GENERALES */
                    table.ldn-table{
                        width: 100%;
                        border-collapse: collapse;
                        table-layout: fixed;
                        font-size: 11px;
                    }
                    table.ldn-table th,
                    table.ldn-table td{
                        border: 1px solid #e6e6e6;
                        padding: 7px 8px;
                        vertical-align: top;
                        word-wrap: break-word;
                    }
                    table.ldn-table th{
                        width: 42%;
                        background: #faf7fb;
                        color: #333;
                        font-weight: 700;
                    }
                    table.ldn-table td{
                        background: #fff;
                        color: #222;
                    }

                    /* LISTAS (Diagnósticos / Trabajos) */
                    ul.ldn-list,
                    ul.ldn-list li{
                        font-size: 12px; /* ↓ reduce contenido */
                        line-height: 1.45;
                    }
                    ul.ldn-list{
                        margin-left: 20px;
                    }
                    ul.ldn-list li{
                        margin-bottom: 6px;
                    }

                    /* TABLA DE REPUESTOS (más pequeña) */
                    table.ldn-parts-table{
                        width: 100%;
                        border-collapse: collapse;
                        table-layout: fixed;
                        font-size: 10.5px; /* ↓ más pequeña */
                    }
                    table.ldn-parts-table th,
                    table.ldn-parts-table td{
                        border: 1px solid #e6e6e6;
                        padding: 5px 6px;  /* ↓ más compacto */
                        vertical-align: top;
                        word-wrap: break-word;
                    }
                    table.ldn-parts-table th{
                        background: #f7f7f7;
                        font-weight: 700;
                    }
                    </style>

                    <!-- Información General y Vehículo -->
                    <div class="row mb-4">
                        <div class="col-6">
                            <h4 class="ldn-section-title">Información General</h4>
                            <div class="ldn-card">
                                <table class="ldn-table">
                                    <tbody>
                                        <tr>
                                            <th>Fecha de Inicio</th>
                                            <td><span t-field="o.date_start"/></td>
                                        </tr>
                                        <tr>
                                            <th>Fecha de Finalización</th>
                                            <td><span t-field="o.date_end"/></td>
                                        </tr>
                                        <tr>
                                            <th>Cliente</th>
                                            <td><span t-field="o.customer_id"/></td>
                                        </tr>
                                        <tr>
                                            <th>Operador/Conductor</th>
                                            <td><span t-field="o.operator_name"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="col-6">
                            <h4 class="ldn-section-title">Información del Vehículo</h4>
                            <div class="ldn-card">
                                <table class="ldn-table">
                                    <tbody>
                                        <tr>
                                            <th>Vehículo</th>
                                            <td><span t-field="o.vehicle_id"/></td>
                                        </tr>
                                        <tr>
                                            <th>Tipo</th>
                                            <td><span t-field="o.vehicle_type"/></td>
                                        </tr>
                                        <tr>
                                            <th>Serie/Placa</th>
                                            <td><span t-field="o.serie_plate"/></td>
                                        </tr>
                                        <tr>
                                            <th>KM / Horas</th>
                                            <td><span t-field="o.km_hours"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Diagnósticos -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <h4 class="ldn-section-title">Diagnósticos</h4>

                            <t t-if="not o.diagnosis_ids">
                                <p class="text-muted">No hay diagnósticos registrados.</p>
                            </t>

                            <t t-if="o.diagnosis_ids">
                                <ul class="ldn-list" style="list-style-type: disc;">
                                    <t t-foreach="o.diagnosis_ids" t-as="diagnosis">
                                        <li>
                                            <span t-field="diagnosis.name"/>
                                        </li>
                                    </t>
                                </ul>
                            </t>
                        </div>
                    </div>

                    <!-- Trabajos Realizados -->
                    <t t-set="all_followups" t-value="[]"/>
                    <t t-foreach="o.diagnosis_ids" t-as="diagnosis">
                        <t t-foreach="diagnosis.followup_ids" t-as="followup">
                            <t t-set="all_followups" t-value="all_followups + [followup]"/>
                        </t>
                    </t>

                    <t t-if="all_followups">
                        <div class="row mb-4">
                            <div class="col-12">
                                <h4 class="ldn-section-title">Trabajos Realizados</h4>

                                <ul class="ldn-list" style="list-style-type: disc;">
                                    <t t-foreach="all_followups" t-as="followup">
                                        <li>
                                            <span t-field="followup.name"/>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </div>
                    </t>

                    <!-- Repuestos suministrados (opcional; por defecto si NO hay diagnósticos) -->
                    <t t-set="show_parts" t-value="o.include_spares_ldn or not o.diagnosis_ids"/>

                    <t t-if="show_parts">
                        <div class="row mb-4">
                            <div class="col-12">
                                <h4 class="ldn-section-title">Otros Repuestos Suministrados</h4>

                                <t t-if="not o.parts_line_ids">
                                    <p class="text-muted">No hay repuestos registrados.</p>
                                </t>

                                <t t-if="o.parts_line_ids">
                                    <table class="ldn-parts-table">
                                        <thead>
                                            <tr>
                                                <th>Repuesto</th>
                                                <th class="text-right">Cant. Entregada</th>
                                                <th>Notas</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="o.parts_line_ids" t-as="line">
                                                <tr>
                                                    <td><span t-esc="line.product_name"/></td>
                                                    <td class="text-right"><span t-esc="line.qty_delivered"/></td>
                                                    <td><span t-esc="line.notes or ''"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                            </div>
                        </div>
                    </t>

                    <!-- Observaciones -->
                    <t t-if="o.observations">
                        <div class="row mb-4">
                            <div class="col-12">
                                <h4 class="ldn-section-title">Observaciones</h4>
                                <p style="white-space: pre-line; font-size: 11px; line-height: 1.45;">
                                    <span t-field="o.observations"/>
                                </p>
                            </div>
                        </div>
                    </t>

                    <!-- Firmas (SIN salto de página previo) -->
                    <div class="row mt-5 mb-5">
                        <div class="col-6 text-center">
                            <h5 style="border-bottom: 1px solid #875a7b; padding-bottom: 3px; font-size: 12px;">Encargado del Mantenimiento</h5>

                            <t t-if="o.maintenance_signature">
                                <img t-att-src="image_data_uri(o.maintenance_signature)"
                                     style="max-width: 250px; max-height: 100px; border: 1px solid #ddd; padding: 2px; margin: 20px 0;"/>
                            </t>
                            <t t-else="">
                                <div style="height: 100px; border: 1px dashed #ccc; margin: 20px 0; display: flex; align-items: center; justify-content: center;">
                                    <span style="color: #999;">Sin firma</span>
                                </div>
                            </t>

                            <div style="border-top: 2px solid #000; display: inline-block; min-width: 250px; margin-top: 5px; padding-top: 10px;">
                                <p style="margin: 2px 0; font-size: 11px;"><strong><span t-field="o.maintenance_responsible_id"/></strong></p>
                                <p style="margin: 0; color: #666; font-size: 11px;">
                                    <span t-field="o.maintenance_responsible_job"/>
                                </p>
                            </div>
                        </div>

                        <div class="col-6 text-center">
                            <h5 style="border-bottom: 1px solid #875a7b; padding-bottom:3px; font-size: 12px;">Representante del Cliente</h5>

                            <t t-if="o.customer_signature">
                                <img t-att-src="image_data_uri(o.customer_signature)"
                                     style="max-width: 250px; max-height: 100px; border: 1px solid #ddd; padding: 2px; margin: 20px 0;"/>
                            </t>
                            <t t-else="">
                                <div style="height: 100px; border: 1px dashed #ccc; margin: 20px 0; display: flex; align-items: center; justify-content: center;">
                                    <span style="color: #999;">Sin firma</span>
                                </div>
                            </t>

                            <div style="border-top: 2px solid #000; display: inline-block; min-width: 250px; margin-top: 5px; padding-top: 10px;">
                                <p style="margin: 2px 0; font-size: 11px;"><strong><span t-field="o.customer_representative_name"/></strong></p>
                                <p style="margin: 0; color: #666; font-size: 11px;">
                                    <span t-field="o.customer_representative_job"/>
                                </p>
                            </div>
                        </div>
                    </div>

                </div>
            </t>
        </t>
    </template>

    <!-- Reporte LDN -->
    <template id="report_maintenance_order_ldn">
        <t t-call="web.html_container">
            <t t-call="report_maintenance_order_ldn_document"/>
        </t>
    </template>
</odoo>
