<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reporte GT (Renombrado) -->
    <record id="action_report_maintenance_order" model="ir.actions.report">
        <field name="name">Orden de Mantenimiento GT</field>
        <field name="model">maintenance.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">global_trucks_mtto.report_maintenance_order</field>
        <field name="report_file">global_trucks_mtto.report_maintenance_order</field>
        <field name="binding_model_id" ref="model_maintenance_order"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'OM-GT - %s' % (object.name)</field>
        <field name="paperformat_id" ref="global_trucks_mtto.paperformat_maintenance_order"/>
    </record>

    <!-- Reporte LDN -->
    <record id="action_report_maintenance_order_ldn" model="ir.actions.report">
        <field name="name">Orden de Mantenimiento LDN</field>
        <field name="model">maintenance.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">global_trucks_mtto.report_maintenance_order_ldn</field>
        <field name="report_file">global_trucks_mtto.report_maintenance_order_ldn</field>
        <field name="binding_model_id" ref="model_maintenance_order"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'OM-LDN - %s' % (object.name)</field>
        <field name="paperformat_id" ref="global_trucks_mtto.paperformat_maintenance_order"/>
    </record>
</odoo>
