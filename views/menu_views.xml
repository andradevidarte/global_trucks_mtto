    <!-- Submenú: Solicitudes de Mantenimiento -->
    <menuitem id="menu_maintenance_solicitud"
              name="Solicitudes"
              parent="menu_maintenance_root"
              action="action_maintenance_solicitud"
              sequence="1"
              groups="group_mtto_director_operaciones,group_mtto_jefe_ventas,group_mtto_supervisor_taller"/>

    <!-- Submenú: Órdenes de Mantenimiento -->
    <menuitem id="menu_maintenance_orders"
