    <!-- ========================================================= -->
    <menuitem id="menu_cliente_solicitud"
              name="Solicitar Mantenimiento"
              parent="menu_global_trucks_root"
              action="action_maintenance_solicitud_simple"
              sequence="1"
              groups="group_mtto_cliente_mantenimiento"/>

    <!-- ========================================================= -->
