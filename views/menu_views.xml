<odoo>
    <!-- Menú principal -->
    <menuitem id="menu_global_trucks_root"
              name="Global Trucks MC SAS"
              sequence="1"
              groups="group_mtto_admin,group_mtto_supervisor,group_mtto_maintenance,group_mtto_sales,group_mtto_director_operaciones,group_mtto_jefe_ventas,group_mtto_supervisor_taller,group_mtto_cliente_mantenimiento"/>

    <!-- ========================================================= -->
