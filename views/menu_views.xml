    <menuitem id="menu_configuration"
              name="Configuración"
              parent="menu_global_trucks_root"
              sequence="100"
              groups="group_mtto_admin,group_mtto_supervisor,group_mtto_director_operaciones"/>

    <!-- Submenú: Vehículos -->
    <menuitem id="menu_vehicles"
              name="Vehículos"
              parent="menu_configuration"
              action="action_maintenance_vehicle"
              sequence="10"
              groups="group_mtto_admin,group_mtto_supervisor,group_mtto_director_operaciones"/>
