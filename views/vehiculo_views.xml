<odoo>
    <record id="view_vehiculo_form" model="ir.ui.view">
        <field name="name">vehiculo.form</field>
        <field name="model">vehiculo.vehiculo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="placa"/>
                    <field name="vehicle_type"/>
                    <field name="modelo"/>
                    <field name="year"/>
                    <field name="brand"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
